# Environment Configuration for Muskingum Materials
# Copy this file to .env.local and fill in your actual values
# Never commit .env.local to version control

# ============================================================================
# Required - Application will not function without these
# ============================================================================

# Neon PostgreSQL Database
# Get these from: https://console.neon.tech/app/projects
# DATABASE_URL: Connection pooler URL for serverless (prisma client)
# DIRECT_URL: Direct connection URL for migrations (prisma migrate)
DATABASE_URL=postgresql://username:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require
DIRECT_URL=postgresql://username:password@host.region.aws.neon.tech/dbname?sslmode=require

# ============================================================================
# OPTIONAL - Features degrade gracefully when missing
# ============================================================================

# -----------------------------------------------------------------------------
# Sanity CMS
# -----------------------------------------------------------------------------
# Get these from: https://www.sanity.io/manage
# Used for: Marketing content, testimonials, FAQs, gallery, blog posts
# Studio available at: /studio
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your_sanity_api_token

# -----------------------------------------------------------------------------
# Clerk Authentication
# -----------------------------------------------------------------------------
# Get these from: https://dashboard.clerk.com
# Used for: User authentication, SSO (Google, GitHub, Apple, Facebook)
# Supports: Guest checkout (works without Clerk, but no user accounts)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# -----------------------------------------------------------------------------
# Stripe Payments
# -----------------------------------------------------------------------------
# Get these from: https://dashboard.stripe.com/test/apikeys
# Used for: Online ordering, checkout sessions, payment processing
# Webhook endpoint: /api/orders/webhook
# Fallback: Order form submits quote requests instead of processing payments
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# -----------------------------------------------------------------------------
# Postmark Email Service
# -----------------------------------------------------------------------------
# Get these from: https://account.postmarkapp.com/servers
# Used for: Order confirmations, quote notifications, contact form, newsletters
# Fallback: Emails not sent, but orders/quotes still save to database
POSTMARK_API_TOKEN=your_postmark_server_token
POSTMARK_FROM_EMAIL=sales@muskingummaterials.com
POSTMARK_TO_EMAIL=sales@muskingummaterials.com

# -----------------------------------------------------------------------------
# Anthropic AI (Claude)
# -----------------------------------------------------------------------------
# Get this from: https://console.anthropic.com/settings/keys
# Used for: AI chat agent with business context and product recommendations
# Fallback: Keyword-matched static responses (see app/api/chat/route.ts)
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key

# -----------------------------------------------------------------------------
# Twilio SMS Notifications
# -----------------------------------------------------------------------------
# Get these from: https://console.twilio.com
# Used for: Order confirmations via SMS, status updates, STOP opt-out handling
# Webhook endpoint: /api/sms/webhook
# Fallback: Email fallback if POSTMARK_API_TOKEN is set, otherwise silent failure
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# -----------------------------------------------------------------------------
# Upstash Redis (Rate Limiting)
# -----------------------------------------------------------------------------
# Get these from: https://console.upstash.com/redis
# Used for: API rate limiting (chat: 5/min, checkout: 10/hr, leads: 20/hr)
# Fallback: In-memory rate limiting (per-instance, not shared across serverless)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# -----------------------------------------------------------------------------
# Sentry Error Tracking
# -----------------------------------------------------------------------------
# Get this from: https://sentry.io/settings/projects/
# Used for: Production error tracking, performance monitoring, session replay
# Fallback: Errors logged to console only
NEXT_PUBLIC_SENTRY_DSN=https://your_sentry_key@sentry.io/project_id
SENTRY_ENABLED=false

# -----------------------------------------------------------------------------
# Google Services
# -----------------------------------------------------------------------------
# Google Analytics: Get from https://analytics.google.com/analytics/web/
# Google Maps API: Get from https://console.cloud.google.com/apis/credentials
# Google Search Console: Get from https://search.google.com/search-console
# Used for: Analytics tracking, embedded maps on /contact, satellite area estimator
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_GSC_VERIFICATION=your_google_search_console_verification_code

# -----------------------------------------------------------------------------
# Site Configuration
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL: Production domain (used in emails, SEO, OpenGraph)
# NEXT_PUBLIC_BASE_URL: Base URL for API calls (defaults to localhost:3000 in dev)
NEXT_PUBLIC_SITE_URL=https://muskingummaterials.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000
